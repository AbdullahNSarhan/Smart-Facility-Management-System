# ==============================================================================
# LCI-SFM Smart Facility Management System — Environment Configuration Template
# Copy this file to .env and replace placeholder values before production start.
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# SQLite Database Storage (WAL mode enabled automatically)
SQLITE_DB_PATH=./data/lci_sfm.db

# One-Time Initial Administrator Bootstrap Credentials
# Used ONLY when system_users has 0 records. Never hardcode 'admin' in production.
LCI_BOOTSTRAP_ADMIN_USERNAME=sfm_admin
LCI_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD_32_CHARS_MINIMUM

# Session & Cookie Security
SESSION_COOKIE_NAME=lci_sid
SESSION_IDLE_TTL_MS=1800000
SESSION_ABSOLUTE_TTL_MS=28800000
SESSION_SECURE_COOKIE=false
ALLOW_BEARER_COMPAT=false
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.43.225

# MQTT Broker Connection (Singleton Client)
MQTT_ENABLED=true
# Host interfaces exposed by Docker. Keep loopback until you deliberately enable LAN access.
FRONTEND_BIND_IP=127.0.0.1
MQTT_BIND_IP=127.0.0.1
MQTT_BROKER_URL=mqtt://mqtt-service:1883
MQTT_USERNAME=lci_backend
MQTT_PASSWORD=replace_with_mosquitto_backend_secret
MQTT_CLIENT_ID=lci-sfm-backend-core
MQTT_CONNECT_TIMEOUT_MS=4000
MQTT_RECONNECT_PERIOD_MS=5000
# A node is STALE if no validated status/telemetry was received within 90 seconds.
# Broker readiness remains independent from attached hardware availability.
MQTT_NODE_STALE_MS=90000

# Command Coordinator Timeout (ms)
COMMAND_ACK_TIMEOUT_MS=5000

# Edge Node Target Identifiers & Default Static LAN IPv4s
NODE1_ID=node1
NODE2_ID=env_02
NODE3_ID=node3
IP_NODE1=192.168.43.11
IP_NODE2=192.168.43.12
IP_NODE3=192.168.43.13
